---
/**
 * AgentTerminal — the build log that types itself (brief §5.2).
 *
 * Decorative: aria-hidden on the animated region, with a real text alternative for
 * screen readers and a visible "ILUSTRASI PROSES" plate so nobody mistakes it for a
 * live console. No counts, no timings, no metrics — nothing that could be read as a
 * fabricated claim (REASONIX.md honesty rules).
 */
import { terminalCopy } from '@/config/hero';

const { footnote, alternative } = terminalCopy;
---
<figure class="terminal" data-terminal>
  <figcaption class="terminal__head">
    <span class="terminal__dot" aria-hidden="true"></span>
    <span class="mono-micro">agent · build</span>
  </figcaption>

  <pre class="terminal__body" aria-hidden="true"><code data-terminal-output></code><span class="terminal__caret" data-terminal-caret></span></pre>

  <p class="visually-hidden">{alternative}</p>

  <p class="terminal__foot mono-micro">{footnote}</p>
</figure>

<style>
  .terminal {
    --terminal-lines: 9;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    margin: 0;
    width: min(100%, 460px);
    min-height: 220px;
    border: var(--border-hairline);
    border-radius: var(--r-lg);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 2%), transparent 40%),
      var(--color-surface-1);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .terminal__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-bottom: var(--border-hairline);
  }

  .terminal__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--color-ember);
    box-shadow: var(--glow-ember);
  }

  .terminal__body {
    margin: 0;
    padding: var(--space-5);
    font-family: 'Geist Mono', 'Geist Mono Fallback', ui-monospace, monospace;
    font-size: var(--fs-mono);
    line-height: 1.75;
    color: var(--color-text-2);
    white-space: pre-wrap;
    word-break: break-word;
    /* Reserved height: the typing animation must never cause layout shift. */
    min-height: calc(var(--terminal-lines) * 1.75em + var(--space-5) * 2);
  }

  .terminal__body :global(.t-prompt) {
    color: var(--color-gold);
  }

  .terminal__body :global(.t-key) {
    color: var(--color-text);
  }

  .terminal__body :global(.t-ok) {
    color: var(--color-gold-bright);
  }

  .terminal__caret {
    display: inline-block;
    width: 7px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--color-gold);
    animation: caret-blink 1.4s steps(1, end) infinite;
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .terminal__foot {
    padding: var(--space-3) var(--space-5);
    border-top: var(--border-hairline);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__caret {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .terminal {
      --terminal-lines: 5;
      width: 100%;
      min-height: 0;
    }
  }
</style>
