---
/**
 * AvailabilityPill — "● Menerima proyek baru" (brief §5.1).
 * Text and visibility come from config. The dot is a live state, so it uses ember
 * (the only place ember is allowed outside the cursor and active agent steps).
 */
import { availability } from '@/config/availability';

export type Props = {
  /** Compact mode hides the label and keeps the dot (mobile header). */
  compact?: boolean;
};

const { compact = false } = Astro.props;
const show = availability.enabled;
---
{show && (
  <span class="pill" data-availability>
    <span class="pill__dot" aria-hidden="true"></span>
    <span class:list={['pill__label', compact && 'pill__label--compact']}>
      {compact ? <span class="visually-hidden">{availability.label}</span> : availability.label}
    </span>
  </span>
)}

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 24px;
    padding: var(--space-1) var(--space-3);
    border: var(--border-hairline);
    border-radius: var(--r-pill);
    font-family: 'Geist Mono', 'Geist Mono Fallback', ui-monospace, monospace;
    font-size: var(--fs-mono-micro);
    letter-spacing: var(--track-mono-micro);
    text-transform: uppercase;
    color: var(--color-text-muted-hi);
    white-space: nowrap;
  }

  .pill__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--color-ember);
    box-shadow: var(--glow-ember);
    animation: pill-breathe 3.2s var(--ease-in-out-quart) infinite;
  }

  @keyframes pill-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 767px) {
    .pill__label--compact {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill__dot {
      animation: none;
    }
  }
</style>
