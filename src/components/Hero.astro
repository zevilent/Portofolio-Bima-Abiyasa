---
/**
 * Hero — the vertical slice that defines the whole site (brief §6/02).
 *
 * Non-negotiables encoded here:
 *  - The h1 and subheadline are real HTML, visible before any JS runs (they are the LCP).
 *  - The headline words are wrapped in masks server-side, so the animation only adds
 *    transforms; if JS never runs, the words stay visible.
 *  - The WebGL canvas is an empty host element: the scene module decides the tier and
 *    injects the canvas after idle time (see src/scripts/webgl/hero.ts).
 */
import { heroCopy } from '@/config/hero';
import { site } from '@/config/site';
import AgentTerminal from './AgentTerminal.astro';
import { withBase } from '@/lib/url';
import { consultWhatsappUrl } from '@/lib/whatsapp';

const waLink = consultWhatsappUrl(site.contact.whatsapp);
const words = heroCopy.headlineLead.trim().split(' ');
---
<section class="hero" data-hero>
  <div class="hero__canvas" data-webgl-host aria-hidden="true">
    <div class="hero__fallback" data-webgl-fallback>
      <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" role="presentation">
        <defs>
          <radialGradient id="heroGlow" cx="50%" cy="45%" r="55%">
            <stop offset="0%" stop-color="#C8A96C" stop-opacity="0.16"></stop>
            <stop offset="100%" stop-color="#C8A96C" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <rect width="1200" height="800" fill="url(#heroGlow)"></rect>
        <g fill="#C8A96C" opacity="0.5">
          <circle cx="180" cy="140" r="1.2"></circle>
          <circle cx="320" cy="260" r="1"></circle>
          <circle cx="460" cy="120" r="1.4"></circle>
          <circle cx="600" cy="300" r="1"></circle>
          <circle cx="740" cy="180" r="1.2"></circle>
          <circle cx="880" cy="260" r="1"></circle>
          <circle cx="1020" cy="150" r="1.3"></circle>
          <circle cx="240" cy="420" r="1"></circle>
          <circle cx="400" cy="520" r="1.2"></circle>
          <circle cx="560" cy="440" r="1"></circle>
          <circle cx="700" cy="560" r="1.3"></circle>
          <circle cx="860" cy="460" r="1"></circle>
          <circle cx="1000" cy="580" r="1.1"></circle>
          <circle cx="1120" cy="400" r="1"></circle>
          <circle cx="120" cy="620" r="1"></circle>
          <circle cx="980" cy="700" r="1"></circle>
        </g>
      </svg>
    </div>
  </div>

  <div class="hero__inner container-page">
    <div class="hero__copy">
      <p class="mono-micro hero__eyebrow">{heroCopy.eyebrow}</p>

      <h1 class="hero__title" data-split>
        {words.map((word, index) => (
          <span class="hero__word" style={`--i:${index}`}>
            <span class="hero__mask"><span class="hero__inner-word" data-word>{word}</span></span>
          </span>
        ))}
        <span class="hero__word hero__word--accent" style={`--i:${words.length}`}>
          <span class="hero__mask">
            <span class="hero__inner-word accent-serif" data-word>{heroCopy.headlineAccent}</span>
          </span>
        </span>
        <span class="hero__word" style={`--i:${words.length + 1}`}>
          <span class="hero__mask">
            <span class="hero__inner-word" data-word>{heroCopy.headlineRest.trim()}</span>
          </span>
        </span>
      </h1>

      <p class="hero__sub">{heroCopy.subheadline}</p>
      <p class="hero__meta mono-micro">{heroCopy.workMode}</p>

      <div class="hero__actions">
        <a
          class="btn btn--primary js-magnetic"
          data-magnetic
          href={`${withBase('/')}${heroCopy.worksAnchor}`}
        >
          <span class="btn__inner">{heroCopy.ctaPrimary}</span>
        </a>
        <a
          class="btn btn--ghost js-magnetic"
          data-magnetic
          data-source="hero"
          href={waLink}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="btn__inner">
            <span class="btn-dot" aria-hidden="true"></span>
            {heroCopy.ctaSecondary}
          </span>
        </a>
      </div>

      <p class="hero__cue mono-micro" aria-hidden="true">{heroCopy.scrollCue} ↓</p>
    </div>

    <div class="hero__terminal">
      <AgentTerminal />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-10)) var(--space-12);
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: var(--z-canvas);
  }

  .hero__canvas :global(canvas) {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-6) var(--ease-luxe);
  }

  .hero__canvas[data-ready] :global(canvas) {
    opacity: 1;
  }

  .hero__canvas[data-ready] .hero__fallback {
    opacity: 0;
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    transition: opacity var(--dur-6) var(--ease-luxe);
  }

  .hero__fallback :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--color-bg) 0%, rgb(10 10 11 / 72%) 42%, transparent 72%),
      linear-gradient(180deg, transparent 60%, var(--color-bg) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: calc(var(--z-content) + 1);
    display: grid;
    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    gap: var(--space-11);
    align-items: center;
    width: 100%;
  }

  .hero__eyebrow {
    color: var(--color-gold);
  }

  .hero__title {
    margin-top: var(--space-6);
    font-size: var(--fs-display-xl);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    max-width: 20ch;
  }

  .hero__word {
    display: inline-block;
    margin-right: 0.22em;
  }

  .hero__mask {
    display: inline-block;
    padding-bottom: 0.08em;
    overflow: hidden;
    vertical-align: bottom;
  }

  .hero__inner-word {
    display: inline-block;
  }

  .hero__word--accent {
    margin-right: 0;
  }

  .hero__sub {
    margin-top: var(--space-7);
    max-width: var(--measure-intro);
    font-size: var(--fs-body-l);
    color: var(--color-text-2);
  }

  .hero__meta {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-9);
  }

  .hero__cue {
    margin-top: var(--space-10);
    color: var(--color-text-muted);
    transition: opacity var(--dur-3) var(--ease-out-quint);
  }

  .hero__terminal {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1023px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-9);
    }

    .hero__terminal {
      justify-content: flex-start;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding-block: calc(var(--header-h-mobile) + var(--space-9)) var(--space-10);
    }

    .hero__title {
      max-width: 14ch;
    }

    .hero__cue {
      display: none;
    }

    .hero::after {
      background: linear-gradient(
        180deg,
        var(--color-bg) 0%,
        rgb(10 10 11 / 55%) 45%,
        var(--color-bg) 100%
      );
    }
  }
</style>
