---
/**
 * Home — M2 vertical slice: header, hero (split-text + agent terminal + WebGL),
 * capability marquee. Later milestones append their sections to this page in place.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CapabilityMarquee from '@/components/CapabilityMarquee.astro';
import { site } from '@/config/site';
---
<BaseLayout>
  <Hero />
  <CapabilityMarquee />

  <section class="container-page placeholder" id="karya">
    <p class="mono-label">M2 / SELANJUTNYA</p>
    <h2>Karya, layanan, proses, harga, dan FAQ menyusul di milestone berikutnya.</h2>
    <p>
      Halaman ini sudah memakai fondasi final: token, tipografi, jarak, gerak, dan
      komponen header/hero yang akan dipakai seluruh situs.
    </p>
    <p class="mono-micro">{site.liveUrl}</p>
  </section>

  <script>
    import '@/scripts/hero-page';
  </script>
</BaseLayout>

<style>
  .placeholder {
    padding-block: var(--section-block);
    border-top: var(--border-hairline);
  }

  .placeholder h2 {
    margin-top: var(--space-5);
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--track-display-m);
    max-width: 26ch;
  }

  .placeholder p {
    margin-top: var(--space-6);
    color: var(--color-text-2);
  }

  .placeholder .mono-micro {
    color: var(--color-text-muted);
  }
</style>
