---
/**
 * Home — M2 vertical slice: header, hero (split-text + agent terminal + WebGL),
 * capability marquee. Later milestones append their sections to this page in place.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CapabilityMarquee from '@/components/CapabilityMarquee.astro';
import WorkStack from '@/components/WorkStack.astro';
import ServiceBento from '@/components/ServiceBento.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import Pricing from '@/components/Pricing.astro';
import TermsFaq from '@/components/TermsFaq.astro';
import { site } from '@/config/site';
---
<BaseLayout>
  <Hero />
  <CapabilityMarquee />
  <WorkStack />
  <ServiceBento />
  <ProcessSection />
  <Pricing />
  <TermsFaq />

  <section class="container-page placeholder">
    <p class="mono-label">M4 / SELANJUTNYA</p>
    <h2>Form brief, command palette, footer lengkap, dan halaman 404 menyusul.</h2>
    <p>{site.liveUrl}</p>
  </section>

  <script>
    import '@/scripts/hero-page';
    import '@/scripts/spotlight';
    import '@/scripts/pricing';
    import '@/scripts/accordion';
  </script>
</BaseLayout>

<style>
  .placeholder {
    padding-block: var(--section-block);
    border-top: var(--border-hairline);
  }

  .placeholder h2 {
    margin-top: var(--space-5);
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--track-display-m);
    max-width: 26ch;
  }

  .placeholder p {
    margin-top: var(--space-6);
    color: var(--color-text-2);
  }

  .placeholder .mono-micro {
    color: var(--color-text-muted);
  }
</style>
